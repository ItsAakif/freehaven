# Normalise text files for cross-platform contributors and CI.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.zip binary
*.pdf binary
*.db binary
*.keystore binary
*.jks binary

package-lock.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
