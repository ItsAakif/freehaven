{
  "expo": {
    "name": "Freehaven",
    "slug": "freehaven",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freehaven",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "app.freehaven.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Freehaven uses the microphone only when you choose push-to-talk in an AI conversation."
      }
    },
    "android": {
      "package": "app.freehaven.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2F5D50"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "buildToolsVersion": "37.0.0",
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "extraProguardRules": "-keep class expo.modules.** { *; }\n-keep class com.sherpaonnx.** { *; }\n-keep class com.drpogodin.reactnativefs.** { *; }"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

